[Unit]
Description=Mengo-Hub Flask Application
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/C:\Users\Will_Newton\Desktop\Mengo-Hub-System - Copy
Environment="PATH=/path/to/your/venv/bin"
Environment="FLASK_ENV=production"
ExecStart=/path/to/your/venv/bin/gunicorn -w 4 -b 127.0.0.1:5000 flask_app:app
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target